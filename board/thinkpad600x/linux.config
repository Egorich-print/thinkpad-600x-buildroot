# IBM ThinkPad 600X kernel config — Pentium III, 64 MB
# Base: x86 32-bit, glibc userspace. Use with Buildroot custom kernel.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_LOG_BUF_SHIFT=15
CONFIG_PROFILING=n
# 440BX APIC/PIT is unreliable: tickless idle can hard-hang at boot. Keep periodic ticks.
# CONFIG_NO_HZ_IDLE is not set
CONFIG_HZ_100=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_SMP is not set
CONFIG_HYPERVISOR_GUEST=n
CONFIG_MPENTIUMIII=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n

# Networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IPV6=m
CONFIG_SYN_COOKIES=y
# No netfilter/iptables, no VPN and no containers ship in this image, so the
# conntrack/tables/xtables modules and TUN/VETH/WireGuard are dead weight.

# Buses/devices
CONFIG_PCI=y
CONFIG_ISA=y
CONFIG_PCCARD=y
CONFIG_PCMCIA=y
CONFIG_CARDBUS=y
CONFIG_YENTA=y
CONFIG_PCCARD_NONSTATIC=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ACPI / APM / power
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_EC=y
# acpi_video conflicts with thinkpad_acpi backlight control
# CONFIG_ACPI_VIDEO is not set
CONFIG_APM=m
CONFIG_SUSPEND=y
# 440BX (Pentium III Katmai) has no SpeedStep/ACPI CPU frequency scaling.
# CONFIG_CPU_FREQ is not set
CONFIG_I2C=y
CONFIG_LEDS_CLASS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_THINKPAD_ACPI=m

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# Serial/parallel
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_CS=m
# No parallel port: the 600X has no LPT and the image ships no print daemon.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# Storage: libata / PATA (PIIX), CD, floppy
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CDROM=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_ATA_BMDMA=y
CONFIG_PATA_PCMCIA=y
CONFIG_BLK_DEV_FD=m

# USB — host controllers + mass storage BUILT-IN so the live image can find
# its root on a USB stick before any module loading is possible.
CONFIG_USB=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
# USB 3.0 (xHCI) does not exist on a 440BX ThinkPad 600X
# CONFIG_USB_XHCI_HCD is not set
CONFIG_USB_STORAGE=y
# No USB serial adapters: the only console is the 8250, and no dialup/callout
# tool is in the image. No usbmon either - usbutils reads sysfs.
CONFIG_HID_GENERIC=y

# Networking hardware: Ethernet
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_MII=y
CONFIG_E100=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_3C59X=m
CONFIG_8139TOO=m
CONFIG_8139CP=m
CONFIG_NE2000=m
CONFIG_NE2K_PCI=m
CONFIG_R8169=m
CONFIG_PCNET32=m
CONFIG_PCMCIA_PCNET=m
CONFIG_PCMCIA_3C574=m
CONFIG_PCMCIA_XIRC2PS=m

# Wireless: Ralink/MediaTek (TL-WN727N 148f:7601 MT7601U + RT5370), Realtek, Atheros
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8192CU=m
CONFIG_RTL_CARDS=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
# RFKILL itself is used by cfg80211/mac80211 for the wireless softkill. The
# INPUT half (an evdev listener for the RFKILL switch) has no consumer here, but
# it cannot be switched off: net/rfkill/Kconfig declares it `default y if
# !EXPERT` with the prompt hidden unless CONFIG_EXPERT, so kconfig forces it on.
# Turning it off would mean enabling EXPERT for one unused driver - not worth it.
CONFIG_RFKILL=m

# Bluetooth: neither BlueZ nor any BT firmware ships in this image, so the whole
# subsystem stays out.

# Framebuffer: NeoMagic 256ZX + VESA fallback
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
# DRM core is only built as a module to satisfy thinkpad_acpi (backlight/privacy);
# the NeoMagic framebuffer remains the actual display path.
CONFIG_DRM=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_SIMPLEDRM=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_NEOMAGIC=y
CONFIG_FB_VGA16=y
CONFIG_FB_MODE_HELPERS=y
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FB_SYS_FOPS=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y
CONFIG_DUMMY_CONSOLE=y

# Sound: Crystal CS46xx (600X) + Intel AC97 + USB audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_CS46XX=m
CONFIG_SND_INTEL8X0=m
CONFIG_SND_AC97_CODEC=m
CONFIG_SND_USB_AUDIO=m

# Hardware monitoring (coretemp/intel-rng are Intel-only and could never bind
# on a PIII/440BX, so they are left out)
CONFIG_HWMON=y
CONFIG_HW_RANDOM=y

# Filesystems — live-CD needs ISO9660 + initramfs built-in
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
# 8 MB ramdisk is plenty; 32 MB would starve a 64 MB machine
CONFIG_BLK_DEV_RAM_SIZE=8192
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# No POSIX ACL support: the image has no getfacl/setfacl and nothing sets a
# default ACL, so the inode ACL fields are never populated.
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
# Intel-only sensors/RNG cannot bind on a PIII/440BX. Both symbols default to
# HW_RANDOM/HWMON, so they have to be switched off explicitly rather than merely
# left out of this file.
# CONFIG_SENSORS_CORETEMP is not set
# CONFIG_HW_RANDOM_INTEL is not set
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_VFAT_FS=m
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_OVERLAY_FS=y
# No pstore: /sys/fs/pstore is never mounted (etc/fstab does not list it), and
# ramoops exposes no device modalias, so mdev coldplug cannot load it either.

# Debugging (keep modest for 64 MB)
CONFIG_PRINTK=y
CONFIG_KALLSYMS=y
CONFIG_ELF_CORE=y
CONFIG_MAGIC_SYSRQ=y