# IBM ThinkPad 600X kernel config — Pentium III, 64 MB
# Base: x86 32-bit, glibc userspace. Use with Buildroot custom kernel.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_LOG_BUF_SHIFT=15
CONFIG_PROFILING=n
CONFIG_NO_HZ_IDLE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_SMP is not set
CONFIG_HYPERVISOR_GUEST=n
CONFIG_MPENTIUMIII=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n

# Networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IPV6=m
CONFIG_SYN_COOKIES=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_WIREGUARD=m

# Buses/devices
CONFIG_PCI=y
CONFIG_ISA=y
CONFIG_PCCARD=y
CONFIG_PCMCIA=y
CONFIG_CARDBUS=y
CONFIG_YENTA=y
CONFIG_PCCARD_NONSTATIC=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ACPI / APM / power
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_EC=y
CONFIG_ACPI_VIDEO=m
CONFIG_APM=m
CONFIG_SUSPEND=y
CONFIG_CPU_FREQ=y
CONFIG_X86_SPEEDSTEP_SMI=m
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_I2C=y
CONFIG_LEDS_CLASS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_THINKPAD_ACPI=m

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# Serial/parallel
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_CS=m
CONFIG_PARPORT=m
CONFIG_PARPORT_PC=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# Storage: libata / PATA (PIIX), CD, floppy
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CDROM=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_ATA_BMDMA=y
CONFIG_PATA_PCMCIA=y
CONFIG_BLK_DEV_FD=m

# USB
CONFIG_USB=y
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_ACM=m
CONFIG_USB_STORAGE=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_GENERIC=m
CONFIG_USB_MON=m
CONFIG_HID_GENERIC=y

# Networking hardware: Ethernet
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_MII=y
CONFIG_E100=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_3C59X=m
CONFIG_8139TOO=m
CONFIG_8139CP=m
CONFIG_NE2000=m
CONFIG_NE2K_PCI=m
CONFIG_R8169=m
CONFIG_PCNET32=m
CONFIG_PCMCIA_PCNET=m
CONFIG_PCMCIA_3C574=m
CONFIG_PCMCIA_XIRC2PS=m

# Wireless: Ralink (TL-WN727N), Realtek, Atheros dongles
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8192CU=m
CONFIG_RTL_CARDS=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_RFKILL=m
CONFIG_RFKILL_INPUT=m

# Bluetooth: btusb + Realtek BT (Ugreen CM591)
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIBCM203X=m

# Framebuffer: NeoMagic 256ZX + VESA fallback
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
# DRM core is only built as a module to satisfy thinkpad_acpi (backlight/privacy);
# the NeoMagic framebuffer remains the actual display path.
CONFIG_DRM=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_SIMPLEDRM=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_NEOMAGIC=y
CONFIG_FB_VGA16=y
CONFIG_FB_MODE_HELPERS=y
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FB_SYS_FOPS=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y
CONFIG_DUMMY_CONSOLE=y

# Sound: Crystal CS46xx (600X) + Intel AC97 + USB audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_CS46XX=m
CONFIG_SND_INTEL8X0=m
CONFIG_SND_AC97_CODEC=m
CONFIG_SND_USB_AUDIO=m

# Hardware monitoring / RNG
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=m

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CONFIGFS_FS=y
CONFIG_AUTOFS4_FS=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_UDF_FS=m
CONFIG_VFAT_FS=m
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NFS_FS=m
CONFIG_NFS_V3=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=m

# Debugging (keep modest for 64 MB)
CONFIG_PRINTK=y
CONFIG_KALLSYMS=y
CONFIG_ELF_CORE=y
CONFIG_MAGIC_SYSRQ=y