#!/bin/sh
#
# Compile the CDE ToolTalk static-type database (types.xdr).
#
# ToolTalk's ttsession refuses to start unless it can load a types database
# (see _Tt_typedb::init_xdr() -> init_types() in CDE).  The types are normally
# built by programs/tttypes, but that runs the *target* tt_type_comp at build
# time, which cannot execute on an aarch64 build host.  So compile them here,
# on the target, into /etc/tt/types.xdr (one of ttsession's search paths).
#
TTC=/usr/dt/bin/tt_type_comp
D=/usr/dt/appconfig/tttypes

[ -x "$TTC" ] || exit 0
[ -d "$D" ] || exit 0
# Already compiled (e.g. on the installed ext4 root)?
[ -s /etc/tt/types.xdr ] && exit 0

mkdir -p /etc/tt
cd /etc/tt || exit 0

# Compile into a scratch directory and publish the result only if it is
# non-empty: ttsession must never load a half-written type database.
TMPD="$(mktemp -d /etc/tt/.types.XXXXXX)" || exit 0
failed=""
for f in "$D"/*.ptype; do
    [ -f "$f" ] || continue
    TTPATH="$TMPD" "$TTC" -sd user -m "$f" >/dev/null 2>&1 || failed="$failed $(basename "$f")"
done

if [ -n "$failed" ]; then
    echo "ToolTalk: tt_type_comp failed for:$failed" >&2
fi
if [ -s "$TMPD/types.xdr" ]; then
    mv -f "$TMPD/types.xdr" /etc/tt/types.xdr
    echo "ToolTalk types compiled ($(wc -c < /etc/tt/types.xdr) bytes)"
else
    echo "ToolTalk: no types.xdr produced - ttsession will likely fail" >&2
fi
rm -rf "$TMPD"
exit 0
