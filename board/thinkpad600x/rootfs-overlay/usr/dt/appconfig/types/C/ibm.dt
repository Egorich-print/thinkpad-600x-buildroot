ACTION Smit
{
        LABEL           %|nls-14001-#Smit#|
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     /usr/dt/bin/dtaction -user root SmitI
        DESCRIPTION     %|nls-14002-#The#|
}
# #####
ACTION SmitI
{
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     /bin/smit
        DESCRIPTION	%|nls-14003-#The#|
}
