ACTION OpenDtWelcome  
{
        LABEL           %|nls-32101-#Label for OpenDtWelcome action#|
	ARG_COUNT	0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     /usr/dt/bin/dthelpview -helpVolume Welcome
        DESCRIPTION     %|nls-32102-#Description for OpenDtWelcome action#|
}
