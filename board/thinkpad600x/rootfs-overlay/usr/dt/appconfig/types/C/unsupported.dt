ACTION DtTypes
{
        LABEL		%|nls-32-#DtTypes#|
        ARG_COUNT	0
	TYPE		COMMAND
	WINDOW_TYPE	NO_STDIO
	EXEC_STRING	/usr/dt/bin/dtterm -e /usr/bin/ksh -c '/usr/dt/bin/dttypes;'
	DESCRIPTION	%|nls-9002-#The#|
}
ACTION DtTypes
{
        LABEL		%|nls-32-#DtTypes#|
	TYPE		COMMAND
	WINDOW_TYPE	PERM_TERMINAL
	EXEC_STRING	sh -c '/usr/dt/bin/dttypes -type "%(File)Arg_1%";                  echo "%|nls-9011-#Select#|"'
	DESCRIPTION	%|nls-9002-#The#|
}
ACTION Clipboard
{
        LABEL		%|nls-27-#Clipboard#|
	TYPE		COMMAND
	WINDOW_TYPE	NO_STDIO
	EXEC_STRING	/usr/local/bin/X11/xclipboard
	DESCRIPTION	%|nls-9003-#The#|
}
