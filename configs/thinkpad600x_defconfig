# IBM ThinkPad 600X — MVP console image (Phase 1)
# Pentium III 500 MHz, 64 MB, i686, glibc, BusyBox init

# --- Target / toolchain ---
BR2_x86_pentium3=y
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_14_X=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_TARGET_OPTIMIZATION="-mtune=pentium3"
BR2_TOOLCHAIN_BUILDROOT_LOCALE=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US.UTF-8"

# --- System ---
BR2_TARGET_GENERIC_HOSTNAME="thinkpad600x"
BR2_TARGET_GENERIC_ISSUE="IBM ThinkPad 600X workstation"
# Passwordless root (hobby machine): empty password, log in as "root" with Enter.
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_THINKPAD600X_PATH)/board/thinkpad600x/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_THINKPAD600X_PATH)/board/thinkpad600x/post-build.sh"
# Filesystem label used by the installed HDD system and by the live media probe.
BR2_ROOTFS_LABEL="THINKPAD600X_LIV"

# --- Kernel ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.104"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_THINKPAD600X_PATH)/board/thinkpad600x/linux.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_CMDLINE="console=tty0 console=ttyS0,115200 acpi=off clocksource=jiffies tsc=unstable"

# --- Base packages ---
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_PROCPS_NG=y

# --- Networking ---
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_IPUTILS_PING=y
BR2_PACKAGE_IPUTILS_TRACEROUTE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_COREUTILS=y

# --- X11 / graphics ---
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_XEPHYR=n
BR2_PACKAGE_XDRIVER_XF86_VIDEO_NEOMAGIC=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_VESA=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_CIRRUS=y
# No udev here, so xf86-input-evdev (needs libudev) is unavailable. The classic
# mouse/keyboard drivers are shipped prebuilt in the rootfs overlay
# (usr/lib/xorg/modules/input/{mouse_drv,kbd_drv}.so) - see package/xf86-input-*
# and docs/X11.md for how they are built.
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XAPP_XAUTH=y
BR2_PACKAGE_XAPP_XRDB=y
BR2_PACKAGE_XAPP_XSET=y
BR2_PACKAGE_XAPP_XMODMAP=y
BR2_PACKAGE_XAPP_SETXKBMAP=y
BR2_PACKAGE_XAPP_XKBCOMP=y
BR2_PACKAGE_XAPP_SESSREG=y
BR2_PACKAGE_XAPP_XDPYINFO=y
BR2_PACKAGE_XAPP_XSETROOT=y
BR2_PACKAGE_XAPP_XRANDR=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_XTERM=y

# --- X11 core fonts (CDE classic look) ---
BR2_PACKAGE_XFONT_ENCODINGS=y
BR2_PACKAGE_XFONT_FONT_ALIAS=y
BR2_PACKAGE_XFONT_FONT_UTIL=y
BR2_PACKAGE_XFONT_FONT_MISC_MISC=y
BR2_PACKAGE_XFONT_FONT_CURSOR_MISC=y
BR2_PACKAGE_XFONT_FONT_ADOBE_75DPI=y
BR2_PACKAGE_XFONT_FONT_ADOBE_100DPI=y
BR2_PACKAGE_XFONT_FONT_BITSTREAM_75DPI=y
BR2_PACKAGE_XFONT_FONT_BITSTREAM_100DPI=y
BR2_PACKAGE_XFONT_FONT_ADOBE_UTOPIA_75DPI=y
BR2_PACKAGE_XFONT_FONT_ADOBE_UTOPIA_100DPI=y
BR2_PACKAGE_XFONT_FONT_BH_75DPI=y
BR2_PACKAGE_XFONT_FONT_BH_100DPI=y

# --- OpenMotif (libXm/libMrm/libUil) ---
BR2_PACKAGE_OPENMOTIF=y

# --- CDE ---
BR2_PACKAGE_CDE=y

# --- Applications ---
BR2_PACKAGE_NANO=y
BR2_PACKAGE_MC=y
BR2_PACKAGE_DILLO=y
BR2_PACKAGE_LYNX=y
BR2_PACKAGE_MUPDF=y
BR2_PACKAGE_FEH=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_BTOP=y
BR2_PACKAGE_FASTFETCH=y
BR2_PACKAGE_ANTIWORD=y
BR2_PACKAGE_NEOMAGIC_DIAG=y

# --- Audio tools (Crystal CS46xx) ---
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# --- Wireless (TL-WN727N 148f:7601 MT7601U) ---
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_USBUTILS=y

# --- RPC portmapper: CDE ToolTalk (ttsession) is built without
#     OPT_UNIX_SOCKET_RPC, so its RPC server needs rpcbind to register. ---
BR2_PACKAGE_RPCBIND=y

# --- Extra low-resource apps (office / system / utilities / browsers) ---
# TrueType fonts: Xft/fontconfig apps (Dillo, ...) need them; the image only
# ships bitmap X11 fonts otherwise ("Unable to find fonts").
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_LIBERATION=y
# Browsers (light): links (text); dillo + lynx are above.
BR2_PACKAGE_LINKS=y
# Editors
BR2_PACKAGE_MG=y
# Documents / office
BR2_PACKAGE_POPPLER=y
BR2_PACKAGE_POPPLER_UTILS=y
BR2_PACKAGE_ENSCRIPT=y
BR2_PACKAGE_SQLITE=y
# System / file utilities
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NCDU=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_ZIP=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_P7ZIP=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_BC=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_SCREEN=y
BR2_PACKAGE_SL=y
# Comms
BR2_PACKAGE_MUTT=y
BR2_PACKAGE_IRSSI=y
# Games / fun
BR2_PACKAGE_GNUCHESS=y
BR2_PACKAGE_ASCII_INVADERS=y
BR2_PACKAGE_CMATRIX=y
BR2_PACKAGE_NYANCAT=y
BR2_PACKAGE_CHOCOLATE_DOOM=y
BR2_PACKAGE_DOOM_WAD=y
# X utilities
BR2_PACKAGE_XAPP_XCLOCK=y
BR2_PACKAGE_XAPP_XLOAD=y
BR2_PACKAGE_XAPP_XCALC=y
BR2_PACKAGE_XAPP_XEYES=y
BR2_PACKAGE_XAPP_XFONTSEL=y
BR2_PACKAGE_XAPP_XMAG=y
BR2_PACKAGE_XAPP_XMAN=y
BR2_PACKAGE_XAPP_BITMAP=y
BR2_PACKAGE_XAPP_XINPUT=y
BR2_PACKAGE_XAPP_XEV=y
BR2_PACKAGE_XAPP_XWININFO=y
BR2_PACKAGE_XAPP_XPROP=y

# --- Filesystem images ---
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_TAR=y

# --- Bootloader: provide extlinux + MBR so the live installer can make the
#     internal HDD bootable without any host-side tooling. ---
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_MBR=y
BR2_TARGET_SYSLINUX_C32="ldlinux.c32"